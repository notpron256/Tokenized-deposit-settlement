# This project runs against two independent networks: the local validator
# (fast, free, disposable — where active development and Phase 8 work
# happens) and public devnet (a promoted snapshot of the stable, tested
# pieces: compliance-hook, the mint, and the sanctions registry — see
# spec-001.md's Areas of concern for what's promoted and what isn't yet).
#
# SOLANA_RPC_URL, DATABASE_URL, and the backend/keys/<network>/ directory
# they imply always move together as one group — never mix a devnet RPC
# URL with the local database, or vice versa. Which network is "active" is
# entirely determined by which block below is uncommented; there is no
# separate flag, so check these two values together to know which
# environment you're pointed at.

# --- Local validator (default) ---
# Keys read/written: backend/keys/local/
SOLANA_RPC_URL=http://localhost:8899
SOLANA_WS_URL=ws://localhost:8900
DATABASE_URL=postgresql://deposit_poc:deposit_poc@localhost:5432/deposit_poc

# --- Devnet (uncomment to point the backend at devnet instead) ---
# Keys read/written: backend/keys/devnet/
# SOLANA_RPC_URL=https://api.devnet.solana.com
# SOLANA_WS_URL=wss://api.devnet.solana.com
# DATABASE_URL=postgresql://deposit_poc:deposit_poc@localhost:5432/deposit_poc_devnet

# Backend
PORT=4100

# Frontend (consumed by the frontend's own .env, not this file directly)
VITE_API_BASE_URL=http://localhost:4100
